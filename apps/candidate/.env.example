# Spec §16. Copy to .env.local and fill in.

# Server
INTERNAL_API_URL="http://localhost:8000"

# Client
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_CANDIDATE_URL="http://localhost:3001"
# Required ONLY in single-host prod (nginx routes /a/* -> candidate,
# / -> admin on one hostname). Set to "/a" so chunk URLs become
# /a/_next/... and the matching nginx regex location strips the
# prefix before proxying to candidate. Leave unset in dev (localhost
# same-origin, no prefix needed).
NEXT_PUBLIC_CANDIDATE_ASSET_PREFIX=""
